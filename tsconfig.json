{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@screens/*": ["screens/*"],
      "@components": ["components"],
      "@constants/*": ["constants/*"],
      "@resources": ["resources"],
      "@stores/*": ["stores/*"],
      "@domain/*": ["domain/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
