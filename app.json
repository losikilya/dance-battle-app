{
  "expo": {
    "name": "dance-battle-app",
    "slug": "dance-battle-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "battle",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C0E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dancebattleapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dancebattleapp",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "./plugins/withHostNetworkInterfaces",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HauoraRegular.ttf",
            "./assets/fonts/HauoraBold.ttf",
            "./assets/fonts/HauoraExtraBold.ttf"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de881646-f27c-4b0b-bb8c-cc027da0044a"
      }
    }
  }
}
